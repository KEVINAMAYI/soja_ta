APP_NAME="Soja webhook tests"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# These credentials must belong to a separate, EMPTY disposable database.
# Its name must end in _test or _testing. All its tables are deleted after tests.
ELEVATEHR_TEST_DB_CONNECTION=mysql
ELEVATEHR_TEST_DB_RESET=true
ELEVATEHR_TEST_DB_HOST=127.0.0.1
ELEVATEHR_TEST_DB_PORT=3306
ELEVATEHR_TEST_DB_DATABASE=soja_webhooks_test
ELEVATEHR_TEST_DB_USERNAME=
ELEVATEHR_TEST_DB_PASSWORD=
ELEVATEHR_TEST_DB_SOCKET=

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
